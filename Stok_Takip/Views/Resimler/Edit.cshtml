@model Stok_Takip.Models.Resimler

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<h1>Edit</h1>

<h4>Resimler</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Resim_Id" />
            <div class="form-group">
                <label asp-for="Resim_Ad" class="control-label"></label>
                <input asp-for="Resim_Ad" class="form-control" />
                <span asp-validation-for="Resim_Ad" class="text-danger"></span>
            </div>

            <div class="form-group">
                <img src="@Model.Resim_Yolu" width="100px" height="100px"/>
                <label asp-for="Images" class="control-label"></label>
                <input type="file" asp-for="Images" class="form-control" />
                <span asp-validation-for="Images" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Urun_Id" class="control-label"></label>
                <select asp-for="Urun_Id" class="form-control" asp-items="ViewBag.Urunliste">Seçiminiz</select>
                <span asp-validation-for="Urun_Id" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
