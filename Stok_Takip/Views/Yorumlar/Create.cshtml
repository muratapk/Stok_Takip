@model Stok_Takip.Models.Yorumlar
@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<h1>Create</h1>
<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="YorumYapan" class="control-label">Yorum Yapan</label>
        <input type="text" asp-for="YorumYapan" class="form-control" />
        <span asp-validation-for="YorumYapan" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Aciklama" class="control-label">Açıklama</label>
        <input asp-for="Aciklama" class="form-control"/>
        <span asp-validation-for="Aciklama" class="text-danger"/>
    </div>
    <div class="form-group">
        <label asp-for="Urun_Id" class="control-label">Ürün Adı</label>
        <select asp-for="Urun_Id" asp-items="ViewBag.UrunListe" class="form-control"></select>
        <span asp-validation-for="Urun_Id" class="text-danger"></span>
    </div>
    <div class="form-group">
        <input type="submit" value="Kayıt Et" class="btn btn-warning"/>
    </div>
</form>

