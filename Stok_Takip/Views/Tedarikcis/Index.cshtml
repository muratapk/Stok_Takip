@model IEnumerable<Stok_Takip.Models.Tedarikci>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Firma_Adi)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Yetkili_Kisi)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Telefon)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Adres)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Firma_Adi)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Yetkili_Kisi)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Telefon)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Adres)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Tedarikci_Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Tedarikci_Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Tedarikci_Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
