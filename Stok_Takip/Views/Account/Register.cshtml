@model Stok_Takip.Dto.RegisterDto
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Bootstrap demo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>
<body>

    <div class="container">
        <div class="row">
            <div class="col-sm-6 col-md-6 offset-2 border rounded p-3">
                <form action="Register" method="Post">

                    <div class="mb-3">
                        <label class="form-label">Adı Soyadı</label>
                        <input type="text" asp-for="AdSoyad" class="form-control" placeholder="Adınızı ve Soyadınızı Girin" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Doğum Tarihi</label>
                        <input type="date" asp-for="DogumTarihi" class="form-control" placeholder="Doğrum  Girin" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Kullanıcı Adı</label>
                        <input type="text" asp-for="UserName" class="form-control" placeholder="Kullanıcı Girin" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email Adresiniz</label>
                        <input type="text" asp-for="UserEmail" class="form-control" placeholder="Emailiniz Girin" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Şifre</label>
                        <input type="password" asp-for="Password" class="form-control" placeholder="Şifrenizi Girin" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Şifre</label>
                        <input type="password" asp-for="ConfirmPassword" class="form-control" placeholder="Şifrenizi Girin" />
                    </div>
                    <div class="mb-3">
                        <button type="submit" class="btn btn-primary">Kayıt Ol</button>
                    </div>
                </form>
            </div>

        </div>
    </div>




    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>