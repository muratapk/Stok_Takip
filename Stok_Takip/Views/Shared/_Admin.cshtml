<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">

</head>
<body>
    <nav class="navbar navbar-expand-lg bg-body-tertiary">
        <div class="container-fluid">
            <a class="navbar-brand" href="#">Admin Panel</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link active" aria-current="page" href="/Musterilers/Index">Müşteriler</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Tedarikcis/Index">Tedarikçiler</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Alis/Index">Alışlar</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/AlisDetays/Index">Alışlar Detayları</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Kategorilers/Index">Kategoriler</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Satislars/Index">Satışlar</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/SatisDetays/Index">Satışlar Detay</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/StokHareketleris/Index">Stok Hareketleri</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Urunlers/Index">Ürünler</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#">Pricing</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link disabled" aria-disabled="true">Disabled</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="row">
            <div class="col-9 offset-3">
                @RenderBody()
            </div>
        </div>
    </div>

    <div>
       
    </div>
</body>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    @await RenderSectionAsync("Scripts", required: false)
</html>
