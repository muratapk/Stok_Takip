@model IEnumerable<Stok_Takip.Models.Urunler>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Urun_Adi)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Barkod)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Alis_Fiyati)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Satis_Fiyati)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Stok_Miktari)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Minumum_Miktari)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.kategoriler)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Urun_Adi)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Barkod)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Alis_Fiyati)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Satis_Fiyati)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Stok_Miktari)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Minumum_Miktari)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.kategoriler.Kategori_Id)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Urun_Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Urun_Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Urun_Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
